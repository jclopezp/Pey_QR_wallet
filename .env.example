# Copy to .env and fill in. Never commit .env.
# Server-only variables: never prefix them with VITE_.

NODE_ENV=development
PORT=3001

# Pey API (https://docs.pey.mx/)
PEY_BASE_URL=https://api.pey.mx
PEY_API_KEY=
PEY_WEBHOOK_SECRET=

# Cookie sessions
SESSION_SECRET=

# SQLite file (used from E1-4)
DATABASE_URL=./data/buzzqr.db
